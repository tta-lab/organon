{
  "name": "organon-pi-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/pi-*' run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "prettier": "3.6.2",
    "@types/node": "24.0.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "typebox": "1.3.7",
    "vitest": "3.2.4"
  }
}
