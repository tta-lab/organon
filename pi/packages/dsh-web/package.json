{
  "name": "@tta-lab/dsh-web",
  "version": "0.1.0",
  "description": "Organon Web provider and explicit Web settings for DeepSeek Harness rc.8.",
  "homepage": "https://github.com/tta-lab/organon#readme",
  "bugs": {
    "url": "https://github.com/tta-lab/organon/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tta-lab/organon.git",
    "directory": "pi/packages/dsh-web"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.cts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-web": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.2.0"
  },
  "optionalDependencies": {
    "@tta-lab/pi-web-darwin-arm64": "workspace:*",
    "@tta-lab/pi-web-linux-arm64": "workspace:*",
    "@tta-lab/pi-web-linux-x64": "workspace:*",
    "@tta-lab/pi-web-win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-web": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "@tta-lab/pi-shared": "workspace:*",
    "@types/node": "24.0.0",
    "@types/react": "^18.3.0",
    "react": "18.3.1",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-web/test"
  }
}
