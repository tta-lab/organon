{
  "name": "@tta-lab/pi-web",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi extension for Organon web capabilities: search, page fetch, documentation, and Sourcegraph code search without MCP.",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@tta-lab/pi-web-darwin-arm64": "workspace:*",
    "@tta-lab/pi-web-linux-arm64": "workspace:*",
    "@tta-lab/pi-web-linux-x64": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@tta-lab/pi-shared": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.0.0",
    "defuddle": "^0.19.2",
    "linkedom": "^0.18.13",
    "markdown-it": "^15.0.0",
    "typebox": "1.3.7"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  }
}
