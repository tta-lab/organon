#!/usr/bin/env node
// Test-only fake web CLI: mirrors the documented JSON contract of the real
// Go binary for search/fetch/docs_resolve/docs_fetch/sgraph with --json.
import { appendFileSync, existsSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
if (process.env.PI_WEB_TEST_INVOCATIONS) {
  appendFileSync(process.env.PI_WEB_TEST_INVOCATIONS, JSON.stringify(args) + "\n");
}
if (!args.includes("--json")) {
  process.stderr.write("Error: --json is required by the extension contract\n");
  process.exit(2);
}
const separatorIndex = args.indexOf("--");
const optionArgs = separatorIndex >= 0 ? args.slice(0, separatorIndex) : args;
const flags = new Map();
for (let i = 0; i < optionArgs.length; i++) {
  if (optionArgs[i].startsWith("--")) {
    const key = optionArgs[i].slice(2);
    const next = optionArgs[i + 1];
    if (next !== undefined && !next.startsWith("--")) {
      flags.set(key, next);
      i++;
    } else {
      flags.set(key, "true");
    }
  }
}
const positional = [];
for (let i = 0; i < optionArgs.length; i++) {
  const value = optionArgs[i];
  if (value.startsWith("--")) {
    if (optionArgs[i + 1] !== undefined && !optionArgs[i + 1].startsWith("--")) i++;
    continue;
  }
  positional.push(value);
}
if (separatorIndex >= 0) positional.push(...args.slice(separatorIndex + 1));
const cmd = positional[0];
const target = positional[1] ?? positional[0];
function recordSearchEvent(phase, query) {
  if (process.env.PI_WEB_TEST_SEARCH_EVENTS) {
    appendFileSync(process.env.PI_WEB_TEST_SEARCH_EVENTS, JSON.stringify({ phase, query }) + "\n");
  }
}
function waitForSearchPeers(barrierPath, query, finish) {
  writeFileSync(`${barrierPath}.${query}`, "");
  const deadline = Date.now() + 5000;
  const poll = () => {
    if (existsSync(`${barrierPath}.slow`) && existsSync(`${barrierPath}.fast`)) {
      finish();
      return;
    }
    if (Date.now() >= deadline) {
      process.stderr.write("Error: search barrier timed out\n");
      process.exit(2);
      return;
    }
    setTimeout(poll, 1);
  };
  poll();
}

switch (cmd) {
  case "search": {
    const query = positional.slice(1).join(" ");
    if (query === "wait-for-abort") {
      const pidPath = process.env.PI_WEB_TEST_PID_FILE;
      if (!pidPath) {
        process.stderr.write("Error: missing PI_WEB_TEST_PID_FILE\n");
        process.exit(2);
      }
      writeFileSync(pidPath, String(process.pid));
      recordSearchEvent("start", query);
      setInterval(() => {}, 1000);
      break;
    }

    recordSearchEvent("start", query);
    const delay = query === "slow" ? 120 : query === "fast" || query === "boom" ? 20 : 0;
    const finish = () => {
      recordSearchEvent("end", query);
      if (query === "boom") {
        process.stderr.write("Error: search backend failed: rate limited\n");
        process.exit(1);
      }
      const results = [
        {
          title: "Result 1 for " + query,
          link: "https://example.com/" + encodeURIComponent(query) + "/1",
          snippet: "snippet 1",
          position: 1,
        },
      ];
      if (query === "slow" || query === "fast") {
        results.push({
          title: "Result 2 for " + query,
          link: "https://example.com/" + encodeURIComponent(query) + "/2",
          snippet: "snippet 2",
          position: 2,
        });
      }
      process.stdout.write(JSON.stringify({ provider: "DuckDuckGo", results }) + "\n");
    };
    const barrierPath = process.env.PI_WEB_TEST_SEARCH_BARRIER;
    if (barrierPath) waitForSearchPeers(barrierPath, query, finish);
    else if (delay === 0) finish();
    else setTimeout(finish, delay);
    break;
  }
  case "fetch": {
    if (target === "https://boom.example") {
      process.stderr.write("Error: fetch https://boom.example: connection refused\n");
      process.exit(1);
    }
    const mode =
      flags.get("tree") === "true" || flags.get("section-id")
        ? "tree"
        : flags.get("full") === "true"
          ? "full"
          : "auto";
    const content =
      target === "https://large.example"
        ? Array.from({ length: 3000 }, (_, index) => `line ${index}`).join("\n")
        : "rendered content of " +
          target +
          " (threshold " +
          (flags.get("tree-threshold") ?? "5000") +
          ")";
    process.stdout.write(JSON.stringify({ url: target, mode, content }) + "\n");
    break;
  }
  case "resolve": {
    const query = positional.slice(1).join(" ");
    if (query === "missing") {
      process.stderr.write('Error: no libraries found for \"missing\"\n');
      process.exit(1);
    }
    process.stdout.write(
      JSON.stringify({
        query,
        libraries: [
          {
            id: "/" + query,
            title: "Library " + query,
            trust_score: 0.9,
            total_snippets: 12,
            versions: ["v1"],
            description: "desc",
          },
        ],
      }) + "\n",
    );
    break;
  }
  case "sgraph": {
    const query = positional.slice(1).join(" ");
    process.stdout.write(JSON.stringify({ content: "matches for " + query }) + "\n");
    break;
  }
  case "docs": {
    const sub = positional[1];
    if (sub === "resolve") {
      const query = positional.slice(2).join(" ");
      if (query === "missing") {
        process.stderr.write('Error: no libraries found for \"missing\"\n');
        process.exit(1);
      }
      process.stdout.write(
        JSON.stringify({
          query,
          libraries: [
            {
              id: "/" + query,
              title: "Library " + query,
              trust_score: 0.9,
              total_snippets: 12,
              versions: ["v1"],
              description: "desc",
            },
          ],
        }) + "\n",
      );
      break;
    }
    if (sub === "fetch") {
      const lib = positional[2];
      const topic = positional[3];
      if (lib === "/missing") {
        process.stderr.write("Error: documentation not found\n");
        process.exit(1);
      }
      process.stdout.write(
        JSON.stringify({
          library_id: lib,
          topic: topic ?? "",
          content: "docs content for " + lib + (topic ? " topic " + topic : ""),
        }) + "\n",
      );
      break;
    }
    process.stderr.write("Error: unknown docs subcommand " + (sub ?? "") + "\n");
    process.exit(2);
  }
  default:
    process.stderr.write("Error: unknown command " + args.join(" ") + "\n");
    process.exit(2);
}
